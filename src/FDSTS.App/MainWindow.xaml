<Window x:Class="FDSTS.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FDSTS"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#F1F3F5">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="FDSTS" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="Financial Decision Support and Tracking System"
                               TextWrapping="Wrap" Margin="0,4,0,20" FontSize="12"/>
                    <Button Content="HOME" Tag="Home" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="FINANCIAL POSITION" Tag="Financial Position" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="PLANNING" Tag="Planning" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="DECISIONS" Tag="Decisions" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="INSIGHTS" Tag="Insights" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="REPORTS" Tag="Reports" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                    <Button Content="ADMINISTRATION" Tag="Administration" Click="Navigate_Click" Margin="0,3" Padding="12,8"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom"
                           Text="FDSTS 0.1 Alpha"
                           Foreground="Gray"
                           FontSize="11"
                           Margin="0,20,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PageTitle"
                       Text="Home"
                       FontSize="30"
                       FontWeight="SemiBold"/>

            <Border Grid.Row="1" Margin="0,25,0,0" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="6">
                <StackPanel Margin="28">
                    <TextBlock x:Name="PageHeading"
                               Text="Welcome to FDSTS"
                               FontSize="22"
                               FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageDescription"
                               Text="Your household financial decision-support dashboard."
                               Margin="0,10,0,25"
                               TextWrapping="Wrap"
                               FontSize="14"/>

                    <UniformGrid Columns="2" Rows="2">
                        <Border Margin="5" Padding="18" BorderBrush="#DDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Financial Position" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Assets, liabilities, accounts and net worth." Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="5" Padding="18" BorderBrush="#DDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Planning" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Actions, research and planning, and decision points." Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="5" Padding="18" BorderBrush="#DDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Decisions" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Track choices, rationale and outcomes." Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="5" Padding="18" BorderBrush="#DDDDDD" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Insights" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="Observations and suggested reviews from FDSTS." Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
